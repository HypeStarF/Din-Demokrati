---
type Item = {
  id?: string
  title: string
  date?: string
  type?: string
  url: string
}

const items: Item[] = (Astro.props.items ?? []) as Item[];
---

<div class="timeline">
  {items.map((item) => (
    <div class="timeline-item">
      <div class="timeline-dot"></div>

      <div class="timeline-content">
        {item.date && <div class="timeline-date">{item.date}</div>}

        <h3>
          <a href={item.url}>{item.title}</a>
        </h3>

        {item.type && (
          <div class="timeline-type">
            {item.type === "prop"
              ? "Proposition"
              : item.type === "mot"
                ? "Motion"
                : item.type}
          </div>
        )}
      </div>
    </div>
  ))}
</div>