---
// @ts-nocheck
const steps = Astro.props.steps || []
---

<div class="law-timeline">

{steps.map(step => (

<div class="law-step">

<div class={`law-circle 
${step.completed ? "done" : ""} 
${step.current ? "current" : ""}`}>

</div>

<div class="law-label">

{step.label}

{step.date && (
<div class="law-date">{step.date}</div>
)}

</div>

</div>

))}

</div>


<style>

.law-timeline{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:10px;
margin-top:20px;
margin-bottom:20px;
position:relative;
}

/* linje */

.law-timeline::before{
content:"";
position:absolute;
top:10px;
left:0;
right:0;
height:2px;
background:#ddd;
z-index:0;
}

/* steg */

.law-step{
display:flex;
flex-direction:column;
align-items:center;
flex:1;
position:relative;
z-index:1;
}

/* cirklar */

.law-circle{
width:20px;
height:20px;
border-radius:50%;
background:#ddd;
border:3px solid white;
box-shadow:0 0 0 2px #ddd;
}

/* klara steg */

.law-circle.done{
background:#005bbb;
box-shadow:0 0 0 2px #005bbb;
}

/* aktuellt steg */

.law-circle.current{
background:white;
box-shadow:0 0 0 3px #005bbb;
}

/* label */

.law-label{
margin-top:10px;
font-size:0.9rem;
text-align:center;
max-width:120px;
}

/* datum */

.law-date{
font-size:0.75rem;
color:#666;
margin-top:4px;
}

@media (max-width:800px){

.law-timeline{
flex-direction:column;
align-items:flex-start;
}

.law-timeline::before{
display:none;
}

.law-step{
flex-direction:row;
align-items:center;
gap:10px;
}

}

</style>