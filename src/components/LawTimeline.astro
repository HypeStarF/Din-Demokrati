---
type Step = {
  label: string
  completed: boolean
  current?: boolean
  date?: string
}

const steps: Step[] = (Astro.props.steps ?? []) as Step[];

let currentIndex = steps.findIndex((step) => step.current);

if (currentIndex === -1) {
  currentIndex = steps.findIndex((step, i) =>
    !step.completed && steps[i - 1]?.completed
  );

  if (currentIndex === -1) {
    currentIndex = steps.length - 1;
  }
}
---

<div class="law-timeline">
  {steps.map((step, i) => (
    <div class="law-step">
      <div
        class={`law-circle ${step.completed ? "done" : ""} ${i === currentIndex ? "current" : ""}`}
      ></div>

      {i < steps.length - 1 && (
        <div class={`law-bar ${step.completed ? "done" : ""}`}></div>
      )}

      <div class="law-label">{step.label}</div>

      {step.date && <div class="law-date">{step.date}</div>}
    </div>
  ))}
</div>

<style>
  .law-timeline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin: 60px 0;
    position: relative;
    gap: 12px;
  }

  .law-step {
    flex: 1;
    text-align: center;
    position: relative;
  }

  .law-circle {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #e5e5e5;
    margin: 0 auto;
    transition: all 0.25s;
  }

  .law-circle.done {
    background: #1b4f9c;
    box-shadow: 0 0 0 6px rgba(27, 79, 156, 0.15);
  }

  .law-circle.current {
    background: #1b4f9c;
    box-shadow:
      0 0 0 6px rgba(27, 79, 156, 0.2),
      0 0 12px rgba(27, 79, 156, 0.5);
    animation: pulse 2s infinite;
  }

  .law-bar {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 100%;
    height: 3px;
    background: #e5e5e5;
    z-index: -1;
  }

  .law-bar.done {
    background: #1b4f9c;
    animation: progressGrow 0.6s ease-out;
  }

  .law-label {
    margin-top: 12px;
    font-size: 14px;
    font-weight: 600;
  }

  .law-date {
    font-size: 12px;
    color: #666;
    margin-top: 4px;
  }

  .law-step:hover .law-circle {
    transform: scale(1.25);
  }

  @keyframes progressGrow {
    from {
      width: 0%;
    }
    to {
      width: 100%;
    }
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(27, 79, 156, 0.6);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(27, 79, 156, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(27, 79, 156, 0);
    }
  }

  @media (max-width: 800px) {
    .law-timeline {
      flex-direction: column;
      gap: 25px;
      margin: 30px 0;
    }

    .law-step {
      text-align: left;
      padding-left: 4px;
    }

    .law-circle {
      margin: 0 0 8px 0;
    }

    .law-bar {
      display: none;
    }
  }
</style>